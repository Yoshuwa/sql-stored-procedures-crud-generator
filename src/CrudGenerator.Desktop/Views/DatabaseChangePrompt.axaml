<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CrudGenerator.Desktop.Views.DatabaseChangePrompt"
        Width="500" Height="330" MinWidth="460" MinHeight="310"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="Confirm database change">
  <Grid RowDefinitions="Auto,*,Auto" Background="#0D1117">
    <Border Background="#151D2C" BorderBrush="#293448" BorderThickness="0,0,0,1" Padding="22,18">
      <Grid ColumnDefinitions="44,*">
        <Border Width="36" Height="36" CornerRadius="18" Background="#553B1D" VerticalAlignment="Top">
          <TextBlock Text="!" Foreground="#FFC46B" FontSize="20" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock x:Name="PromptTitle" FontSize="19" FontWeight="SemiBold" Foreground="#F5F7FB" />
          <TextBlock Text="Review the target before continuing" FontSize="11" Foreground="#9BA9C0" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="22,18" Spacing="14">
      <TextBlock x:Name="PromptMessage" Foreground="#C9D2E1" FontSize="12"
                 TextWrapping="Wrap" />

      <Border Background="#151A23" BorderBrush="#303A4B" BorderThickness="1"
              CornerRadius="7" Padding="14,12">
        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto">
          <TextBlock Text="DATABASE" Foreground="#8C99AD" FontSize="10" FontWeight="SemiBold" />
          <TextBlock x:Name="DatabaseName" Grid.Column="1" Foreground="#F5F7FB"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="TableLabel" Grid.Row="1" Text="TABLE" Foreground="#8C99AD"
                     FontSize="10" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock x:Name="TableName" Grid.Row="1" Grid.Column="1" Foreground="#F5F7FB"
                     FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>

      <TextBlock Text="Tip: generate and review a preview before applying database changes."
                 Foreground="#8C99AD" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="2" Background="#121821" BorderBrush="#293448" BorderThickness="0,1,0,0"
            Padding="22,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="Cancel" Click="OnCancelClicked" MinWidth="96" />
        <Button x:Name="ConfirmButton" Click="OnConfirmClicked" MinWidth="150"
                Background="#B74A43" Foreground="White" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
